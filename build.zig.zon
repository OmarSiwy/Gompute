.{
    .name = .gompute,
    .version = "1.0.0",
    .fingerprint = 0x4f38064d65c9560,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    // `examples` and `tests` are deliberately absent: consumers never build
    // them, and they would be vendored verbatim into every dependent's package
    // hash. `build.zig` does name `tests/codegen.zig`, but only past the
    // `b.pkg_hash.len != 0` early return, which a dependency never reaches.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "README.md",
        "LICENSE",
    },
}
